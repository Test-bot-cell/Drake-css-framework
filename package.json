{
    "name": "drake.css",
    "title": "Drake.css framework",
    "description": "Drake.css framework — private TypeScript, mobile-first fork of UIkit 3.25.20 with CSS-only Tabler Outline icons and embedded Inter variable faces.",
    "version": "0.1.0",
    "private": true,
    "main": "dist/js/drake.js",
    "types": "dist/types/drake.d.ts",
    "style": "dist/css/drake.css",
    "files": [
        "dist/css/*.css",
        "dist/js/*.js",
        "dist/js/components/*.js",
        "dist/types/**/*.d.ts",
        "dist/fork-manifest.json",
        "src/icons/*.json",
        "src/js/**/*.ts",
        "panda.config.ts",
        "src/styles/**/*.ts",
        "docs/fork/*.md",
        "licenses/*.txt",
        "AGENTS.md",
        "FORK.md",
        "THIRD_PARTY_NOTICES.md"
    ],
    "sideEffects": [
        "*.css",
        "./src/js/*.ts",
        "./dist/**/*.js"
    ],
    "scripts": {
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc -p tests/types",
        "build-assets": "node build/fork/generate-tabler-icons.js && node build/fork/generate-inter-css.js",
        "build-icons-css": "node build/fork/generate-tabler-icons.js",
        "build-inter-css": "node build/fork/generate-inter-css.js",
        "build-manifest": "node build/fork/dist-manifest.js",
        "check-assets": "node build/fork/check-assets.js",
        "check-compat": "node build/fork/check-compat",
        "audit-heritage": "node build/fork/audit-heritage",
        "check-frontend": "node build/fork/check-frontend.js",
        "check-node-runtime": "node build/fork/check-node-runtime.js",
        "compile": "pnpm compile-css && pnpm compile-js && pnpm compile-types",
        "compile-types": "node build/types.js",
        "compile-js": "node build/build",
        "compile-rtl": "node build/panda rtl",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepack": "pnpm build-assets && pnpm compile && pnpm compile-rtl && pnpm build-manifest && pnpm check-node-runtime && pnpm check-assets",
        "prefix": "node build/prefix",
        "scope": "node build/scope",
        "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build-assets && pnpm compile && pnpm compile-rtl && pnpm build-manifest && pnpm check-node-runtime && pnpm check-assets && pnpm check-frontend",
        "watch": "node build/watch.js",
        "compile-css": "node build/panda"
    },
    "drakeFork": {
        "upstream": "https://github.com/uikit/uikit.git",
        "baseTag": "v3.25.20",
        "baseCommit": "45cc430052ba967de8e9972507dee4d37701552d"
    },
    "license": "MIT",
    "packageManager": "pnpm@11.4.0",
    "engines": {
        "node": "24.18.0",
        "pnpm": "11.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@pandacss/dev": "1.11.4",
        "@pandacss/node": "1.11.4",
        "@pandacss/types": "1.11.4",
        "@rollup/plugin-alias": "^6.0.0",
        "@tabler/icons": "3.45.0",
        "camelcase": "^9.0.0",
        "esbuild": "^0.28.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "execa": "^9.6.1",
        "globals": "^17.0.0",
        "inquirer": "^14.0.2",
        "lightningcss": "1.33.0",
        "minimist": "^1.2.8",
        "p-limit": "^7.2.0",
        "postcss": "8.5.20",
        "prettier": "^3.7.4",
        "prettier-plugin-organize-imports": "^4.3.0",
        "rollup": "^4.53.5",
        "rollup-plugin-esbuild": "^6.2.1",
        "rtlcss": "^4.3.0",
        "strip-css-comments": "^5.0.0",
        "svgo": "^4.0.0",
        "typescript": "5.5.2",
        "typescript-eslint": "8.65.0"
    }
}
