{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "isolatedModules": true,
        "noUncheckedIndexedAccess": true,
        "useUnknownInCatchVariables": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "types": [],
        "baseUrl": ".",
        "paths": {
            "drake.css": ["../../dist/types/drake.d.ts"]
        },
        "skipLibCheck": false,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["consumer.ts", "../../dist/types/drake-global.d.ts"]
}
