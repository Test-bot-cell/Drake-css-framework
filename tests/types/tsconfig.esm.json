{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "isolatedModules": true,
        "noUncheckedIndexedAccess": true,
        "useUnknownInCatchVariables": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "types": [],
        "skipLibCheck": false,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["consumer-esm.ts"]
}
