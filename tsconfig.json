{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "isolatedModules": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "baseUrl": ".",
        "paths": {
            "uikit-util": ["src/js/util"]
        },
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/js/**/*", "tests/js/**/*"],
    "exclude": ["node_modules", "dist"]
}
